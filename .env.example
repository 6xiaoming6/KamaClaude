# KamaClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
KAMA_HOST=127.0.0.1
KAMA_PORT=7437

# ── Logging ───────────────────────────────────────────────────
KAMA_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
KAMA_LOG_FILE=~/.kama/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
KAMA_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# KAMA_CONFIG=~/.kama/config.toml

# ── Bash 执行后端 ──────────────────────────────────────────
# 默认 docker；首次先按 README 显式构建镜像，不会自动回退本机
# KAMA_EXECUTION_BACKEND=docker
# KAMA_DOCKER_IMAGE=kamaclaude-sandbox:py312-node24
# KAMA_DOCKER_CPUS=2
# KAMA_DOCKER_MEMORY_MB=2048
# KAMA_DOCKER_PIDS_LIMIT=128
# 显式使用本机 Windows cmd / POSIX sh：KAMA_EXECUTION_BACKEND=host

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# KAMA_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# KAMA_MAX_STEPS=0                    # 0 不限步数
# KAMA_AGENT_MAX_RUN_SECONDS=1800     # 30 分钟，0 关闭时间限制
# KAMA_AGENT_MAX_TOTAL_TOKENS=0       # 0 关闭累计 Token 限制
# KAMA_SUBAGENT_MAX_ACTIVE=2
# KAMA_SUBAGENT_MAX_TOTAL=6
# KAMA_PERMISSION_TIMEOUT_S=300
# 默认使用 1M 有效上下文；此上限不能超过模型实际窗口
# KAMA_COMPACT_WINDOW_TOKENS=1048576
# 也可把 KAMA_CONFIG 指向 configs/context-256k.toml 或 configs/context-1m.toml 的绝对路径。
# 文件预设包含配套比例，切换后需重启 Core；下列环境变量会覆盖预设。
# 上下文份额按窗口比例计算；工具输出字符限长不变
# KAMA_COMPACT_THRESHOLD=0.8         # 1M 窗口下约 800K 输入开始摘要
# KAMA_COMPACT_OUTPUT_RATIO=0.03125  # 1M 下单次输出上限 32K
# KAMA_COMPACT_SAFETY_RATIO=0.02
# KAMA_COMPACT_KEEP_TURNS=3
# KAMA_COMPACT_RECENT_RATIO=0.20    # 1M 下近期原文最多约 200K
# KAMA_COMPACT_SUMMARY_RATIO=0.03125 # 1M 下摘要上限 32K
# KAMA_COMPACT_SUMMARY_TARGET_RATIO=0.0078125
# KAMA_COMPACT_TOOL_LIMIT=32000       # 字符数，不随窗口变化
# KAMA_COMPACT_TOOL_KEEP=24000
# KAMA_MEMORY_GLOBAL_AUTO_RATIO=0.0005
# KAMA_MEMORY_PROJECT_INDEX_RATIO=0.001
# KAMA_TOOL_SEARCH_MAX_LOADED_SCHEMA_RATIO=0.01
